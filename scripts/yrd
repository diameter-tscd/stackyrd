#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DIST_DIR="${SCRIPT_DIR}/dist"

OS="$(uname -s)"
ARCH="$(uname -m)"

case "${OS}" in
  Darwin) os="darwin" ;;
  Linux) os="linux" ;;
  FreeBSD) os="freebsd" ;;
  OpenBSD) os="openbsd" ;;
  NetBSD) os="netbsd" ;;
  *) echo "Unsupported OS: ${OS}" >&2; exit 1 ;;
esac

case "${ARCH}" in
  x86_64) arch="amd64" ;;
  aarch64|arm64) arch="arm64" ;;
  armv7l|arm) arch="arm" ;;
  i386|i686|386) arch="386" ;;
  *) echo "Unsupported architecture: ${ARCH}" >&2; exit 1 ;;
esac

BIN="${DIST_DIR}/yrd_${os}_${arch}"

if [ ! -x "${BIN}" ]; then
  echo "Missing binary: ${BIN}" >&2
  echo "Run '${SCRIPT_DIR}/build-all.sh' to build." >&2
  exit 1
fi

exec "${BIN}" "$@"
