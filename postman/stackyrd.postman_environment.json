{
	"id": "stackyrd-local-env-0001",
	"name": "stackyrd — Local (8452)",
	"description": "Local dev environment for the stackyrd Postman collection. Mirrors config.yaml defaults: server.port 8452, api prefix /api/v1, MCP token, pg/mongo tenant names. Duplicate for staging/prod and swap baseUrl + mcpToken.",
	"values": [
		{ "key": "baseUrl", "value": "http://localhost:8452", "enabled": true, "description": "Echo server root" },
		{ "key": "apiBase", "value": "http://localhost:8452/api/v1", "enabled": true, "description": "Service prefix (server.services_endpoint)" },
		{ "key": "mcpToken", "value": "f76fda0080884d4ab36b93abf6421d49", "enabled": true, "description": "mcp.token — Bearer for /mcp + dashboard-logs. NEVER commit a real prod token." },
		{ "key": "pgTenant", "value": "primary", "enabled": true, "description": "Postgres connection (primary|secondary)" },
		{ "key": "mongoTenant", "value": "primary", "enabled": true, "description": "Mongo connection (primary|secondary)" },
		{ "key": "userId", "value": "1", "enabled": true, "description": "Correlated from Users create" },
		{ "key": "taskId", "value": "1", "enabled": true, "description": "Correlated from Tasks create" },
		{ "key": "orderId", "value": "1", "enabled": true, "description": "Correlated from Orders create" },
		{ "key": "productId", "value": "", "enabled": true, "description": "Correlated Mongo ObjectID hex" },
		{ "key": "cacheKey", "value": "demo-key", "enabled": true, "description": "Correlated cache key" },
		{ "key": "streamId", "value": "demo-notifications", "enabled": true, "description": "SSE stream id" },
		{ "key": "encryptedData", "value": "", "enabled": true, "description": "Correlated ciphertext" },
		{ "key": "grafanaUid", "value": "demo-dash", "enabled": true, "description": "Grafana dashboard uid" },
		{ "key": "webhookSecret", "value": "whsec-test-secret", "enabled": true, "description": "HMAC key for webhook signing demo" }
	],
	"_postman_variable_scope": "environment"
}
